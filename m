 	[ -n "$(mptcp_lib_evts_get_info "saddr6" "$evts" $t)" ] && ip=6
 	tk=$(mptcp_lib_evts_get_info token "$evts")
@@ -3319,10 +3303,10 @@ userspace_pm_rm_sf()
 # $1: ns
 userspace_pm_dump()
 {
