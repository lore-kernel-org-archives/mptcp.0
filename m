 	ip netns exec $1 ./pm_nl_ctl get $2 token $tk
@@ -3468,7 +3452,7 @@ userspace_tests()
 		chk_rm_nr 2 2 invert
 		chk_mptcp_info subflows 0 subflows 0
 		chk_subflows_total 1 1
